<mxfile host="app.diagrams.net" type="device">
  <diagram name="GitHub Workflow" id="gh-flow">
    <mxGraphModel dx="1200" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="540" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="&lt;b&gt;GitHub Workflow — Feature Branch se Merge tak&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;&quot;&gt;main safe rakho, kaam feature branch par, PR se merge&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontFamily=Segoe UI;fontSize=19;align=center;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1040" height="52" as="geometry" />
        </mxCell>

        <!-- protection note -->
        <mxCell id="prot" value="&lt;b&gt;Branch protection:&lt;/b&gt; main mein merge se pehle PR + kam se kam 1 approver zaroori" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;fontColor=#5C4A00;fontFamily=Segoe UI;fontSize=11;align=center;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="480" height="34" as="geometry" />
        </mxCell>

        <!-- main branch lane -->
        <mxCell id="main" value="main branch   (protected — seedha push mana hai)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontFamily=Segoe UI;fontStyle=1;fontSize=13;align=center;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="128" width="1020" height="42" as="geometry" />
        </mxCell>

        <!-- feature lane label -->
        <mxCell id="flabel" value="feature/mcp branch:" style="text;html=1;fontFamily=Segoe UI;fontSize=12;fontColor=#5B6B7B;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="226" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- feature steps -->
        <mxCell id="b1" value="&lt;b&gt;1. Branch banao&lt;/b&gt;&lt;br&gt;git checkout -b feature/mcp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#2E75B6;fontColor=#1F4E79;fontFamily=Segoe UI;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="252" width="150" height="84" as="geometry" /></mxCell>
        <mxCell id="b2" value="&lt;b&gt;2. Code add karo&lt;/b&gt;&lt;br&gt;(tfvars mein rg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#2E75B6;fontColor=#1F4E79;fontFamily=Segoe UI;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="234" y="252" width="150" height="84" as="geometry" /></mxCell>
        <mxCell id="b3" value="&lt;b&gt;3. Save aur bhejo&lt;/b&gt;&lt;br&gt;git add .&lt;br&gt;git commit -m&lt;br&gt;git push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#2E75B6;fontColor=#1F4E79;fontFamily=Segoe UI;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="408" y="252" width="150" height="84" as="geometry" /></mxCell>
        <mxCell id="b4" value="&lt;b&gt;4. Pipeline chalti&lt;/b&gt;&lt;br&gt;Scan stage&lt;br&gt;Plan stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE0F2;strokeColor=#2E75B6;fontColor=#1F4E79;fontFamily=Segoe UI;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="582" y="252" width="150" height="84" as="geometry" /></mxCell>
        <mxCell id="b5" value="&lt;b&gt;5. Pull Request&lt;/b&gt;&lt;br&gt;PR raise +&lt;br&gt;reviewer set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#2E75B6;fontColor=#1F4E79;fontFamily=Segoe UI;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="756" y="252" width="150" height="84" as="geometry" /></mxCell>
        <mxCell id="b6" value="&lt;b&gt;6. Review + approve&lt;/b&gt;&lt;br&gt;reviewer check&lt;br&gt;karke approve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontFamily=Segoe UI;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="252" width="150" height="84" as="geometry" /></mxCell>

        <!-- step arrows -->
        <mxCell id="s12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E75B6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E75B6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E75B6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E75B6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E75B6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- branch out arrow -->
        <mxCell id="bout" value="branch banao" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F4E79;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontColor=#1F4E79;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="main" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- merge arrow -->
        <mxCell id="mergeArr" value="merge (approve ke baad)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D32;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;fontColor=#2E7D32;exitX=0.5;exitY=0;entryX=0.92;entryY=1;" edge="1" parent="1" source="b6" target="main"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- explanation notes (teacher side-notes) -->
        <mxCell id="n1" value="Feature branch = alag jagah kaam.&#10;Main saaf aur safe rehta hai." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;fontColor=#5C4A00;fontFamily=Segoe UI;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="356" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Scan = security scan (tfsec/tflint).&#10;Plan = terraform plan — kya banega ka preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;fontColor=#5C4A00;fontFamily=Segoe UI;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="356" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="PR = code review + merge ki request.&#10;Reviewer approve kare, tabhi main mein merge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;fontColor=#5C4A00;fontFamily=Segoe UI;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="356" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- golden rule -->
        <mxCell id="rule" value="&lt;b&gt;Golden rule:&lt;/b&gt;  main mein kabhi seedha push mat karo — hamesha feature branch banao aur PR se merge karo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DCF0;strokeColor=#7A5FA6;fontColor=#4A2E75;fontFamily=Segoe UI;fontSize=12;align=center;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="1020" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
